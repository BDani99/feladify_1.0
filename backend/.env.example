# Szerver
PORT=5000

# MongoDB kapcsolati string (pl. MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# JWT hitelesítés
JWT_SECRET=<hosszú, véletlenszerű, titkos string>
JWT_EXPIRES_IN=12h

# AI szolgáltatók (kötelező az AI funkciókhoz: kérdésgenerálás, javítás, chat)
DEEPSEEK_API_KEY=<deepseek api kulcs>
QWEN_API_KEY=<alibaba dashscope / qwen api kulcs>

# Opcionális, jelenleg nincs aktívan használva (fenntartva)
GEMINI_API_KEY=

# Opcionális: vesszővel elválasztott lista, ha szűkíteni akarod a CORS-t
# egy adott frontend domain(ek)re. Üresen hagyva minden origin engedélyezett.
ALLOWED_ORIGINS=

# Opcionális: `npm run create-admin` paraméterezéséhez.
# Ha nincs megadva, a script véletlenszerű jelszót generál és kiírja egyszer.
ADMIN_USERNAME=feladifyadmin
ADMIN_EMAIL=feladifyadmin@feladify.local
ADMIN_PASSWORD=
